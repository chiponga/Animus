# ----- Identidade (obrigatÃ³rios) -----
AGENT_NAME=Animus
OWNER_NAME=Chefe
OWNER_TELEGRAM_ID=000000000

# ----- Branding (opcionais, default = AGENT_NAME) -----
COMPANY_NAME=Animus IA
PRODUCT_NAME=Animus Premium

# ----- Telegram (obrigatÃ³rios) -----
# Token do @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456:TROCAR_PELO_TOKEN_DO_BOTFATHER
# Lista CSV de user_ids autorizados; em geral sÃ³ o seu
ALLOWED_USERS=000000000

# ----- Comportamento do bot -----
# Timeout (segundos) por mensagem antes do watchdog matar o claude -p
CLAUDE_TIMEOUT=300
# Caminho do binÃ¡rio do Claude (deixe vazio pra autodetect via PATH)
CLAUDE_BIN=

# ----- Banco de dados (opcional â€” memÃ³ria vetorial) -----
# Se vocÃª usa Supabase Postgres com pgvector, cole a connection string aqui.
# SenÃ£o deixe vazio â€” o agente roda sem memÃ³ria persistente.
DATABASE_URL=

# ----- Ãudio bidirecional (opcional) -----
# Whisper transcreve Ã¡udios recebidos
OPENAI_API_KEY=
# ElevenLabs gera Ã¡udio nas respostas
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ----- Anthropic API direta (opcional) -----
# SÃ³ preencha se for usar a API direta alÃ©m do Claude Pro/Max jÃ¡ logado.
ANTHROPIC_API_KEY=

# =========================================================
# SKILLS â€” chaves opcionais (cada uma destrava 1+ skills)
# Deixe vazio o que nÃ£o vai usar. Skill ignora se a key tÃ¡ ausente.
# =========================================================

# Muapi.ai â€” geraÃ§Ã£o de imagem/vÃ­deo (skill: visual-gen)
# Conta em https://muapi.ai. Pay-per-generation.
MUAPI_API_KEY=

# Google Gemini â€” usado por reddit-icp-monitor, claude-md-generator,
# producthunt-launch-kit, meeting-brief-generator.
# GrÃ¡tis em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Reddit OAuth (opcional pra reddit-icp-monitor; sem isso usa endpoint pÃºblico 10 RPM)
# Cria app em https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ValidEmail.co â€” verificaÃ§Ã£o real de cold email (skill: cold-email-verifier)
# Trial grÃ¡tis 50 verificaÃ§Ãµes em https://validemail.co
VALIDEMAIL_API_KEY=

# Tavily â€” busca usada em meeting-brief-generator
# GrÃ¡tis em https://tavily.com
TAVILY_API_KEY=

# Notion (opcional pra meeting-brief-generator salvar resumo em DB)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Hacker News monitor (skill: hackernews-intel)
# HN_KEYWORDS = CSV de termos pra monitorar (ex: "ai agents,telegram bot")
HN_KEYWORDS=
HN_MIN_POINTS=50
HN_INCLUDE_COMMENTS=false
HN_DB_PATH=
# Slack webhook pra receber alertas (opcional)
SLACK_WEBHOOK=

# ----- Deploy de projetos (opcional) -----
# Usado por skills que criam repo privado e publicam HTML/service na Gradsky.
# GitHub: PAT com permissao para criar/push em repos privados.
GH_TOKEN=
GH_USER=
GH_EMAIL=

# Gradsky PAT: gerar em Settings -> Tokens de Acesso.
# Scopes minimos para deploy: read + deploy.
# Para atualizar env vars HTML: secrets:write.
# Para dominio customizado: domains:write.
GRADSKY_TOKEN=
GRADSKY_API=https://api.gradsky.com.br
GRADSKY_PROJECT_ID=
GRADSKY_PUBLIC_DOMAIN=true
GRADSKY_ATTACH_DOMAIN=false
GRADSKY_VERIFY_DOMAIN=false
GRADSKY_FORCE_DOMAIN=false
GRADSKY_GIT_AUTO_DEPLOY=true
GRADSKY_FORCE_DEPLOY=false
DOMINIO_BASE=
