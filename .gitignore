# =========================================================
# Animus — .gitignore
# Mantém o repo focado em código/config; runtime data fora.
# =========================================================

# Secrets (NUNCA commitar)
.env
.env.local
.env.*.local
*.pem
*.key

# Runtime do bot Telegram (cada instalação gera o seu)
animus-bot/audio/
animus-bot/inbox/
animus-bot/outbox/
animus-bot/processed/
animus-bot/sent/
animus-bot/state/
animus-bot/logs/
animus-bot/__pycache__/

# Pastas órfãs/legacy de runtime
audio/
inbox/
outbox/
processed/
sent/
state/
logs/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Node
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# Builds e caches
dist/
build/
.cache/
.parcel-cache/
.next/
.turbo/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Projetos auxiliares fora do escopo do Animus
fluxo-plus/

# Sandboxes / artefatos de teste local
calculadora.html
landing-financeiro.html

# Memória local (cada instalação gera as suas notas)
memory/
.learnings/*.local.md
