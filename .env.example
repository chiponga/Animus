# =========================================================
# .env.example — Animus (Gradsky)
# =========================================================
# Copie pra /workspace/Animus/.env e preencha. Não commite.
# Defina modo 600 (umask 077 antes de criar, ou chmod 600 depois).
# =========================================================

# ----- Identidade (obrigatórios) -----
AGENT_NAME=Animus
OWNER_NAME=Chefe
OWNER_TELEGRAM_ID=000000000

# ----- Branding (opcionais, default = AGENT_NAME) -----
COMPANY_NAME=Animus IA
PRODUCT_NAME=Animus Premium

# ----- Telegram (obrigatórios) -----
# Token do @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456:TROCAR_PELO_TOKEN_DO_BOTFATHER
# Lista CSV de user_ids autorizados; em geral só o seu
ALLOWED_USERS=000000000

# ----- Comportamento do bot -----
# Timeout (segundos) por mensagem antes do watchdog matar o claude -p
CLAUDE_TIMEOUT=180
# Caminho do binário do Claude (deixe vazio pra autodetect via PATH)
CLAUDE_BIN=

# ----- Banco de dados (opcional — memória vetorial) -----
# Se você usa Supabase Postgres com pgvector, cole a connection string aqui.
# Senão deixe vazio — o agente roda sem memória persistente.
DATABASE_URL=

# ----- Áudio bidirecional (opcional) -----
# Whisper transcreve áudios recebidos
OPENAI_API_KEY=
# ElevenLabs gera áudio nas respostas
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ----- Anthropic API direta (opcional) -----
# Só preencha se for usar a API direta além do Claude Pro/Max já logado.
ANTHROPIC_API_KEY=

# ----- Deploy de projetos (opcional) -----
# Se o agente for criar repos no GitHub, autentique com:
#   gh auth login
# (não precisa colocar token aqui)
